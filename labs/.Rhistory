y = rnorm(100)
X = cbind(1,rnorm(100))
# Define sample sizes (n values)
N_s = c(2, 5, 10, 50, 100, 200, 500, 1000)
Nsim = 1e5
# Create an empty matrix to store the angle differences
angles = matrix(0, nrow = Nsim, ncol = length(N_s))
# Loop over each sample size
for (j in seq_along(N_s)) {
n_val = N_s[j]
for (i in 1:Nsim) {
# Create a n_val x 2 matrix: first column ones, second column iid normals.
X = matrix(1, nrow = n_val, ncol = 2)
X[, 2] = rnorm(n_val)
# Compute cosine of the angle between the two columns.
cos_theta = sum(X[, 1] * X[, 2]) / (norm_vec(X[, 1]) * norm_vec(X[, 2]))
# Compute the angle in degrees
angle = acos(cos_theta) * 180 / pi
# Compute the absolute difference from 90 degrees
angles[i, j] = abs(90 - angle)
}
}
#TO-DO
# Function to compute vector norm
norm_vec = function(v) {
sqrt(sum(v^2))
}
# Define sample sizes (n values)
N_s = c(2, 5, 10, 50, 100, 200, 500, 1000)
Nsim = 1e5
# Create an empty matrix to store the angle differences
angles = matrix(0, nrow = Nsim, ncol = length(N_s))
# Loop over each sample size
for (j in seq_along(N_s)) {
n_val = N_s[j]
for (i in 1:Nsim) {
# Create a n_val x 2 matrix: first column ones, second column iid normals.
X = matrix(1, nrow = n_val, ncol = 2)
X[, 2] = rnorm(n_val)
# Compute cosine of the angle between the two columns.
cos_theta = sum(X[, 1] * X[, 2]) / (norm_vec(X[, 1]) * norm_vec(X[, 2]))
# Compute the angle in degrees
angle = acos(cos_theta) * 180 / pi
# Compute the absolute difference from 90 degrees
angles[i, j] = abs(90 - angle)
}
}
# Compute the average absolute angle for each sample size
avg_angles = colMeans(angles)
print("Average absolute angle differences (in degrees) for each n in N_s:")
print(avg_angles)
