Nsim = 1000
RMSE_trains = array(NA, Nsim)
RMSE_tests = array(NA, Nsim)
for (nsim in 1:Nsim) {
idx_train = sample(1:n, n_train, replace = FALSE)
idx_test = setdiff(1:n, idx_train)
boston_train = MASS::Boston[idx_train, ]
boston_test = MASS::Boston[idx_test, ]
mod = lm(medv ~ ., data = boston_train)
# Compute in-sample RMSE
yhat_train = predict(mod, boston_train)
e_train = boston_train$medv - yhat_train
RMSE_trains[nsim] = sd(e_train)
# Compute out-of-sample RMSE
yhat_test = predict(mod, boston_test)
e_test = boston_test$medv - yhat_test
RMSE_tests[nsim] = sd(e_test)
}
mean(RMSE_trains)
mean(RMSE_tests)
