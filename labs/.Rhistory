#TODO
# Assume n, X, and y are already defined.
# Here, n is the total number of observations.
# X is the design matrix and y is the response vector.
# We assume X does NOT include a constant column.
library(MASS)
k = 5
n_test = round(n * 1/k)
n_train = n - n_test
Nsim = 1000
oosSSE_array = numeric(Nsim)
s_e_array = numeric(Nsim)
for (i in 1:Nsim) {
all_indices = 1:n
test_indices = sample(all_indices, size = n_test, replace = FALSE)
train_indices = setdiff(all_indices, test_indices)
X_train = X[train_indices, ]
X_test = X[test_indices, ]
y_train = y[train_indices]
y_test = y[test_indices]
model = lm(y_train ~ X_train + 0)
# Predict on the test set
y_hat_test = predict(model, newdata = data.frame(X_train = X_test))
# Compute out-of-sample standard error (sample standard deviation of test residuals)
oosSSE_array[i] = sd(y_test - y_hat_test)
# Compute in-sample standard error (sample standard deviation of residuals from the training fit)
s_e_array[i] = sd(model$residuals)
}
