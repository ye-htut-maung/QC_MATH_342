X_train1 = matrix(c(0, 0,
1, 1,
2, 2), ncol = 2, byrow = TRUE)
y_train1 = c("A", "B", "B")
X_test1 = matrix(c(0.1, -0.1,  # close to (0,0)
1.2, 1.1,   # close to (1,1)
1.8, 2.1),  # close to (2,2)
ncol = 2, byrow = TRUE)
predictions = nn_algorithm_predict(X_train1, y_train1, X_test1)
print(predictions)
