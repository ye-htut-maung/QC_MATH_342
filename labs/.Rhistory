X_test= X[idx_test, ]
y_test = y[idx_test]
b = solve(t(X_train)%*% X_train) %*% t(X_train) %*% y_train
yhat_train =X_train %*% b
e_train = y_train - yhat_train
RMSE_trains[nsim] = sd(e_train)
yhat_test = X_test %*% b
e_test = y_test - yhat_test
RMSE_tests[nsim] = sd(e_test)
}
