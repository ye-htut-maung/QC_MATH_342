#TO-DO
nn_algorithm_predict = function(Xinput, y_binary, Xtest, d = NULL){
#TO-DO
if (is.null(d)) {
d = function(u, v) {sum((u-v)^2)}
}
n_train = nrow(Xinput)
n_test = nrow(Xtest)
y_test = array(NA, dim = ntest)
for (i_test in 1:n_test){
x_star = Xtest[i_test,]
# 1 for row 2 for column in 2nd parameter of apply function
distances = apply(Xinput, 1, function(x) {d(x, x_star)})
nearest_index = which.min(distances)
y_test[i_test] = y_binary[nearest_index]
}
y_test
}
set.seed(1984)
n = 20
x = runif(n)
beta_0 = 3
beta_1 = -2
h_star_x = beta_0 + beta_1 * x
epsilon = rnorm(n, mean = 0, sd = 0.33)
y = h_star_x + epsilon
pacman::p_load(ggplot2)
simple_df = data.frame(x = x, y = y)
simple_viz_obj = ggplot(simple_df, aes(x, y)) +
geom_point(size = 2)
simple_viz_obj
my_simple_ols = function(x, y){
ols_obj = list()
#TO-DO
if (!is.numeric(x) | !is.numeric(y)) {
stop("Inputs must be numeric.")
}
if (length(x) != length(y)) {
stop("Inputs must be the same length.")
}
n = length(x)
x_bar = sum(x) / n
y_bar = sum(y) / n
numerator = sum(x*y) - (n * x_bar * y_bar)
denomenator = sum(x^2) - (n * (x_bar) ^ 2)
b_1 = numerator / denomenator
b_0 = y_bar - b_1 * x_bar
y_hat = b_0 + b_1 * x
e = y - y_hat
SSE = sum(e^2)
SST = sum((y - y_bar)^2)
MSE = SSE / n
RMSE = sqrt(MSE)
Rsq = 1 - SSE / SST
ols_obj = list(b_0 = b_0,
b_1 = b_1,
e = e,
SSE = SSE,
MSE = MSE,
RMSE = RMSE,
Rsq = Rsq)
class(ols_obj) = "my_simple_ols_obj"
ols_obj
}
lm_mod = lm(y ~ x)
my_simple_ols_mod = my_simple_ols(x, y)
#run the tests to ensure the function is up to spec
pacman::p_load(testthat)
expect_equal(my_simple_ols_mod$b_0, as.numeric(coef(lm_mod)[1]), tol = 1e-4)
expect_equal(my_simple_ols_mod$b_1, as.numeric(coef(lm_mod)[2]), tol = 1e-4)
expect_equal(my_simple_ols_mod$RMSE, summary(lm_mod)$sigma, tol = 1e-4)
my_simple_ols = function(x, y){
ols_obj = list()
#TO-DO
if (!is.numeric(x) | !is.numeric(y)) {
stop("Inputs must be numeric.")
}
if (length(x) != length(y)) {
stop("Inputs must be the same length.")
}
n = length(x)
x_bar = sum(x) / n
y_bar = sum(y) / n
numerator = sum(x*y) - (n * x_bar * y_bar)
denomenator = sum(x^2) - (n * (x_bar) ^ 2)
b_1 = numerator / denomenator
b_0 = y_bar - b_1 * x_bar
y_hat = b_0 + b_1 * x
e = y - y_hat
SSE = sum(e^2)
SST = sum((y - y_bar)^2)
MSE = SSE / (n-2)
RMSE = sqrt(MSE)
Rsq = 1 - SSE / SST
ols_obj = list(b_0 = b_0,
b_1 = b_1,
e = e,
SSE = SSE,
MSE = MSE,
RMSE = RMSE,
Rsq = Rsq)
class(ols_obj) = "my_simple_ols_obj"
ols_obj
}
lm_mod = lm(y ~ x)
my_simple_ols_mod = my_simple_ols(x, y)
#run the tests to ensure the function is up to spec
pacman::p_load(testthat)
expect_equal(my_simple_ols_mod$b_0, as.numeric(coef(lm_mod)[1]), tol = 1e-4)
expect_equal(my_simple_ols_mod$b_1, as.numeric(coef(lm_mod)[2]), tol = 1e-4)
expect_equal(my_simple_ols_mod$RMSE, summary(lm_mod)$sigma, tol = 1e-4)
expect_equal(my_simple_ols_mod$Rsq, summary(lm_mod)$r.squared, tol = 1e-4)
#TO-DO
expect_equal(sum(my_simple_ols_mod$e) / length(my_simple_ols_mod$e), 0, tol = 1e-4)
#TO-DO
X = cbind(1,x)
X
#TO-DO
X = model.matrix(~x)
X
g = function(my_simple_ols_obj, x_star){
#TO-DO
y_hat_star = my_simple_ols_obj$b_0 + my_simple_ols_obj$b_1 * x_star
return (y_hat_star)
}
expect_equal(g(my_simple_ols_mod, mean(x)), mean(y))
beta_0 = 3
beta_1 = -2
beta = c(beta_0, beta_1)
ns = c(20, 50, 100, 200, 500, 1000, 5000, 10000)
errors = array(NA, length(ns))
for (i in 1 : length(ns)) {
n = ns[i]
x = runif(n)
h_star_x = beta_0 + beta_1 * x
epsilon = rnorm(n, mean = 0, sd = 0.33)
y = h_star_x + epsilon
#TO-DO
mod = my_simple_ols(x,y)
b = c(mod$b_0, mod$b_1)
errors[i] = sum((beta - b)^2)
}
errors
