my_ols = function(X, y){
#TO-DO
p = ncol(X)
n = nrow(X)
df = p + 1
X = cbind(1,X)
b = solve(t(X) %*% X) %8% t(X) %*% y
yhat = X %*% b
e = y - yhat
SSE = sum(e**2)
SST = sum((y-mean(y))**2)
MSE = SSE / (n - df)
RMSE = sqrt(MSE)
Rsq = 1 - SSE/SST
list(b=b, yhat=hat, df=df, SSE = SSE, SST = SST, MSE = MSE, RMSE=RMSE, Rsq, Rsq)
class(obj) = "my_ols"
obj
}
