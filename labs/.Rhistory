X = as.matrix(cbind(1, MASS::Boston[, 1:13]))
y = MASS::Boston$medv
p_plus_one = 14
results = matrix(NA, p_plus_one, p_plus_one)
for(j in 1:p_plus_one) {
X_j = X[ , 1:j]
results[j, 1:j] = solve(t(X_j) %*% X_j) %*% t(X_j) %*% y
}
round(results, 3)
#TO-DO
n = nrow(X)
results = array(NA, p_plus_one)
SST = (n - 1) * var(y)
for(j in 1:p_plus_one) {
X_j = X[ , 1:j, drop=FALSE]
e = (diag(n) - X_j %*% solve(t(X_j) %*% X_j) %*% t(X_j)) %*% y
results[j] = 1- sum(e^2 )/ SST
}
round(results, 3)
