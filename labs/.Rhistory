e_train = boston_train$medv - yhat_train
RMSE_trains[nsim] = sd(e_train)
# Compute out-of-sample RMSE
yhat_test = predict(mod, boston_test)
e_test = boston_test$medv - yhat_test
RMSE_tests[nsim] = sd(e_test)
}
