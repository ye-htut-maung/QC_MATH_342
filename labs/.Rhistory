data(iris)
head(iris)
X = cbind(1, as.matrix(iris[, 1 : 4]))
y = as.numeric(iris$Species)
H = X %*% solve(t(X) %*% X) %*% t(X)
#TO-DO
pacman::p_load(testthat)
expect_equal(H,t(H))
pacman::p_load(testthat)
#TO-DO
expect_equal(H, H %*% H)
#TO-DO
sum(diag(H))
#TO-DO
yhat = H %*% y
e = y - yhat
expect_equal(sum(e*yhat), 0)
#TO-DO
SST = sum((y-mean(y))^2)
SSR = sum((yhat - mean(y))^2)
SSE = sum(e^2)
Rsq = SSR / SST
expect_equal(SST, SSR + SSE)
#TO-DO
u = y - mean(y)
v = yhat - mean(y)
cosine_theta = sum(u*v)/sqrt(sum(u^2) * sum(v^2))
expect_equal(Rsq, cosine_theta^2)
