pacman::p_load(ggplot2)
ggplot(
rbind(
data.frame(s_e = s_e_by_p, p = 1 : n_train, series = "in-sample"),
data.frame(s_e = ooss_e_by_p, p = 1 : n_train, series = "out-of-sample")
)) +
geom_line(aes(x = p, y = s_e, col = series))
